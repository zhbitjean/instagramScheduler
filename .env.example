POSTFLOW_LOCAL_PORT=3030
POSTFLOW_OAUTH_CALLBACK_PORT=3031
POSTFLOW_MEDIA_ROOT=C:\Instagram\READY
POSTFLOW_DONE_ROOT=C:\Instagram\READY\DONE
# Postflow's public Instagram App ID is built into the local service.
INSTAGRAM_APP_SECRET=
# Set automatically by start-postflow.ps1 when using its HTTPS tunnel.
INSTAGRAM_REDIRECT_URI=
